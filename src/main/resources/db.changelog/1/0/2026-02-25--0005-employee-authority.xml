<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.0.xsd
        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">

    <changeSet id="2026-02-25--0005-employee-authority" author="okalugin">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="employee_authority"/>
            </not>
        </preConditions>

        <createTable tableName="employee_authority">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="employee_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_auth_employee" referencedTableName="employee"
                             referencedColumnNames="id"/>
            </column>

            <column name="authority_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_auth_authority" referencedTableName="authority"
                             referencedColumnNames="id"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>